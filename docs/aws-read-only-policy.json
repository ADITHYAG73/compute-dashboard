{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ComputeDashboardReadOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceTypes",
        "cloudtrail:LookupEvents"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "ap-south-1"
          ]
        }
      }
    }
  ]
}
